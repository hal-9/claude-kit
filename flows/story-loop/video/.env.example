# Copy to .env (git-ignored) to narrate with ElevenLabs instead of the Mac's `say`.
ELEVENLABS_API_KEY=
# Optional: a voice from your ElevenLabs voices, and the model.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: where in video/music.mp3 to start (seconds), and its level in dB.
# MUSIC_START=22
# MUSIC_DB=-21
